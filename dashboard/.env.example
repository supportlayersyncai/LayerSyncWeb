# ── Dashboard (Vite, browser) ────────────────────────────────────────────
# Your Convex deployment, from `npx convex dev` / the Convex dashboard.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ── Collector (api/collect.ts, api/lead.ts: Vercel env, and .env.local for dev) ──
# The deployment's HTTP actions URL (same name, .convex.site).
CONVEX_SITE_URL=https://your-deployment.convex.site
# Long random secret shared with Convex. Generate with: openssl rand -hex 32
SYNCSITE_INGEST_SECRET=

# ── Convex deployment env (npx convex env set NAME VALUE), NOT here ───────
#   SYNCSITE_INGEST_SECRET  same value as above
#   DASHBOARD_URL           https://dashboard.layersyncai.com (links in emails)
#   SITE_URL                same as DASHBOARD_URL (Convex Auth)
#   JWT_PRIVATE_KEY, JWKS   set by `npx @convex-dev/auth`
#   RESEND_API_KEY          lead emails, invites, password reset codes
#   EMAIL_FROM              "SyncSite <notify@layersyncai.com>" (verified domain)
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT   browser push (npx web-push generate-vapid-keys)
#   MCP_ALLOWED_ORIGINS     optional, comma-separated browser origins allowed to call /mcp
