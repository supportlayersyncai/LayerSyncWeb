{
  "name": "syncsite-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:tracker && vite",
    "dev:backend": "convex dev",
    "demo": "npm run build:tracker && vite --mode demo",
    "build": "npm run build:tracker && tsc -b && vite build",
    "build:tracker": "node scripts/build-tracker.mjs",
    "preview": "vite preview",
    "codegen": "node scripts/codegen.mjs",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tracker": "node scripts/test-tracker.mjs"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "convex-test": "^0.0.67",
    "esbuild": "^0.28.2",
    "jose": "^6.2.16",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.4.3",
    "convex": "^1.49.0",
    "lucide-react": "^1.70.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.5",
    "web-push": "^4.0.0"
  }
}
