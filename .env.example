# Copy to .env (which is gitignored) and fill in. NEVER commit real keys.

# --- Asset generation (build-time only, server-side) ----------------------
# Used by `npm run generate:assets` to create og-image.png etc.
# NOTE: NO "VITE_" prefix on purpose — this key must never be bundled into
# the client. It is only read by the Node script in scripts/.
OPENAI_API_KEY=

# --- Contact form backend (client-side) -----------------------------------
# Supabase project "Website" in the Layersyncai Org (ref scqmpmvtyjwghnrznzoa).
# These ARE exposed to the browser by design — that is safe here because the
# diagnostic_requests table has RLS enabled with INSERT-only access for anon.
# Never add an anon SELECT policy, or every lead becomes world-readable.
# Get the current publishable key from: Supabase dashboard > Project Settings > API Keys
VITE_SUPABASE_URL=https://scqmpmvtyjwghnrznzoa.supabase.co
VITE_SUPABASE_ANON_KEY=
